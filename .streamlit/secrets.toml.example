# Optional. Omit both values for local SQLite storage.
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
# Server-side service_role key, never an anon/publishable key. Never expose to browsers.
SUPABASE_KEY = "YOUR_SERVICE_ROLE_KEY"
# Optional canonical public app URL for sharing subjects.
APP_URL = "https://YOUR_APP.streamlit.app"
